{
  "name": "frostdeck",
  "version": "1.0.0",
  "description": "Decky plugin for Steam Deck: install Battle.net, launch Blizzard games from Steam, and manage World of Warcraft addons from Gaming Mode.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "deploy": "./deploy.sh"
  },
  "keywords": [
    "decky",
    "decky-plugin",
    "steam-deck",
    "battle-net",
    "world-of-warcraft",
    "wow-addons",
    "proton"
  ],
  "author": "Cody Conroy",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cconroy11/FrostDeck.git"
  },
  "homepage": "https://github.com/cconroy11/FrostDeck#readme",
  "bugs": {
    "url": "https://github.com/cconroy11/FrostDeck/issues"
  }
}
